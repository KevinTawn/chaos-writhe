PORT=3000
# dev：本地开发，允许无 Ticket 连接；ticket：生产认证模式
AUTH_MODE=ticket
AUTH_DEV_OPEN=0
# 统一认证中心（你自建的网站后端）
AUTH_CENTER_URL=https://your-site.example.com
AUTH_INTROSPECT_PATH=/api/game/introspect
AUTH_ME_PATH=/api/me
# 生产必须替换为随机长字符串；只放在游戏服务器
GAME_TICKET_SECRET=change-me-to-a-long-random-secret
GAME_TICKET_TTL_SECONDS=60
# 浏览器/Cookie 跨域时需要；EXE 直连可留空
API_CORS_ORIGIN=https://your-site.example.com
# 可选：网站登录地址
AUTH_LOGIN_URL=https://your-site.example.com/login
